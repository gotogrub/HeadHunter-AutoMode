# HeadHunter Destroyer - Переменные окружения
# Скопируйте этот файл в .env и заполните своими значениями

# ======================
# Основные настройки
# ======================

# Режим сервера (headless браузер)
HH_SERVER_MODE=true

# Выбор браузера: chrome, edge, firefox, auto
HH_BROWSER=auto

# ======================
# Telegram Bot
# ======================

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Ваш Telegram ID (узнать через @userinfobot)
TELEGRAM_OWNER_ID=

# ======================
# AI - Ollama (Локальный LLM - РЕКОМЕНДУЕТСЯ)
# ======================

# Провайдер: auto, openai, ollama, disabled
HH_AI_PROVIDER=auto

# URL Ollama сервера
OLLAMA_HOST=http://localhost:11434

# Модель: llama2, mistral, gemma
OLLAMA_MODEL=llama2

# ======================
# AI - OpenAI (Платный)
# ======================

# API ключ OpenAI
OPENAI_API_KEY=

# Модель GPT
OPENAI_MODEL=gpt-3.5-turbo

# ======================
# Поиск вакансий
# ======================

# Регион: 1=Москва, 2=СПб, 113=Россия
HH_AREA=113

# Минимальная зарплата
HH_MIN_SALARY=

# Опыт: noExperience, between1And3, between3And6, moreThan6
HH_EXPERIENCE=

# График: fullDay, shift, flexible, remote, flyInFlyOut
HH_SCHEDULE=
